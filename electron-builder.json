{
  "appId": "com.myujiku.app",
  "productName": "Myujiku",
  "directories": {
    "output": "F:\\Myujiku"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone",
      "filter": ["**/*"]
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules"
    },
    {
      "from": "yt-dlp.exe",
      "to": "yt-dlp.exe"
    }
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Myujiku",
    "artifactName": "Myujiku-Setup-${version}.${ext}",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "Myujiku-Standalone-${version}.${ext}"
  }
}
