{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for MyuJiku",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-get-discord-status",
    "allow-get-discord-debug-info",
    "allow-set-presence",
    "allow-clear-presence",
    "allow-send-test-presence",
    "allow-set-discord-client-id",
    "allow-send-discord-webhook"
  ],
  "remote": {
    "urls": [
      "https://myujiku.vercel.app",
      "https://myujiku.vercel.app/*",
      "http://localhost:3000",
      "http://localhost:3000/*"
    ]
  }
}
