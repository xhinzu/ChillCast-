{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyuJiku",
  "version": "1.0.0",
  "identifier": "com.myujiku.app",
  "build": {
    "frontendDist": "../src-tauri/fallback",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../yt-dlp.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
