{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MyuJiku",
  "version": "1.0.0",
  "identifier": "com.myujiku.app",
  "build": {
    "frontendDist": "../src-tauri/fallback",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyuJiku",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["en-US"],
        "displayLanguageSelector": false
      }
    }
  }
}
