# ChillCast Environment Variables

# 1. Spotify Credentials (used on the server for Client Credentials playlist metadata resolution)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 2. Google Cloud YouTube Data API v3 Key
# (Used strictly on the server for Spotify-to-YouTube track resolution, with permanent caching)
YOUTUBE_API_KEY=

# 3. Next.js Public URL (optional, defaults to http://127.0.0.1:3000 for local dev)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# 4. Supabase Auth & Database (Required for user accounts: Discord OAuth & Email login)
# Public variables (safe to expose in client code and repository):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only variable (STRICTLY PRIVATE - add to Vercel env vars, NEVER log or expose):
SUPABASE_SERVICE_ROLE_KEY=

# 5. Cloudflare Turnstile CAPTCHA (Optional, off by default)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
